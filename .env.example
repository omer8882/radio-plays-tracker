# Global environment defaults for docker-compose

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=radio_plays
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Application ports
API_PORT=8080
FRONTEND_PORT=3000

# Timezone applied to containers
TZ=Asia/Jerusalem

# Spotify credentials for the recognizer worker
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Frontend build-time API base URL. Leave empty in production so browsers use
# the same-origin /api proxy. Set this only when intentionally using another API.
FRONTEND_API_BASE_URL=

# Optional public domain for CORS. Override or add more entries via service env.
CORS_ALLOWED_ORIGIN=https://mahushma.com

# Cloudflared configuration directory (bind mounted into the container)
CLOUDFLARED_CONFIG_DIR=./ops/cloudflared

# Optional Cloudflare tunnel token (enable with `--profile tunnel`)
# CLOUDFLARED_TUNNEL_TOKEN=

# Backups (deploy/backup.sh, see BACKUP.md). Use a passphrase different from MaHuRaa's
# and Friends', and keep it in a password manager: without it the backups are unreadable.
# RPT_BACKUP_PASSPHRASE=
# RPT_BACKUP_REMOTE=gdrive:RadioPlaysTracker-Backups
